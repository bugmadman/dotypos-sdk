includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 9
    paths:
        - src

    # TEMPORARY — remove once plan item 1.2.4-b lands (constructor-based DTOs + a
    # custom denormalizer, done after the test suite from item 5.3 exists to catch
    # regressions). DTO::$eTag is readonly and set via DTO::setETag(), which is
    # declared inside DTO itself — PHP allows a readonly property to be written once
    # from any method of its declaring class, not only the constructor (verified
    # empirically). PHPStan enforces a stricter rule than the language does: it only
    # accepts constructor assignment. The pattern is correct and tested; these 2
    # findings are a PHPStan strictness limit, not a bug.
    ignoreErrors:
        -
            identifier: property.uninitializedReadonly
            path: src/Infrastructure/DTO/DTO.php
        -
            identifier: property.readOnlyAssignNotInConstructor
            path: src/Infrastructure/DTO/DTO.php
